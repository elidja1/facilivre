# ==============================================
# FaciLivre — Environment Variables Reference
# ==============================================
# Copy this file to .env for local development.
# For production, set these in your Vercel Dashboard
# (Project Settings ? Environment Variables).

# -- General ----------------------------------
NODE_ENV=production

# -- API (NestJS) -----------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=api/v1

# -- CORS (production includes all Vercel frontend domains) ---
CORS_ORIGINS="https://student-omega-gilt.vercel.app,https://facilivre-admin.vercel.app"

# -- Frontend Public URLs ----------------------
# Set these in Vercel Dashboard for each app:
#   - student app  ? NEXT_PUBLIC_API_URL=https://facilivre-api.vercel.app
#   - admin app    ? NEXT_PUBLIC_API_URL=https://facilivre-api.vercel.app
NEXT_PUBLIC_API_URL=https://facilivre-api.vercel.app
NEXT_PUBLIC_STUDENT_URL=https://student-omega-gilt.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://facilivre-admin.vercel.app

# -- Database (Supabase PostgreSQL via Prisma) -
# Get from: Supabase Dashboard ? Project Settings ? Database ? URI (Transaction Pooler)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# -- Supabase Project Keys ---------------------
# Get from: Supabase Dashboard ? Project Settings ? API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# -- JWT Secrets -------------------------------
# Generate strong random strings for production!
JWT_ACCESS_SECRET="change_me_strong_random_min_64_chars"
JWT_REFRESH_SECRET="change_me_strong_random_min_64_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
