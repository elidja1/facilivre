{
  "name": "facilivre",
  "version": "0.1.0",
  "private": true,
  "description": "FaciLivre - Scalable Social Learning Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:student": "turbo run dev --filter=@facilivre/student",
    "dev:admin": "turbo run dev --filter=@facilivre/admin",
    "dev:api": "turbo run dev --filter=@facilivre/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:push": "prisma db push --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
