{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npm run build --filter=@facilivre/student",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://facilivre-api.vercel.app",
    "NEXT_PUBLIC_STUDENT_URL": "https://student-omega-gilt.vercel.app",
    "NEXT_PUBLIC_ADMIN_URL": "https://facilivre-admin.vercel.app"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
